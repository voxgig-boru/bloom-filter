# bloom-filter direct unit tests using boru:test's imperative API.
#
# The sibling file `test/bloom_unit_spec.aql` covers the same kind of
# example-based checks through the declarative spec surface
# (`Test.spec` / `Test.case` / `Test.run-spec`).
#
# Run:
#   boru test/bloom_unit_test.aql


# Import the library BEFORE boru:test: works around an upstream boru defect
# (main @ 64c5ab2) — boru:test mints its record types from a fresh type-ID
# counter (lang/go/modules/test.go BuildTestModule lacks
# `modReg.Types.AdoptSeqFrom(parent.Types)`), so with boru:test first every
# BloomFilter-returning word fails `expected BloomFilter, got BloomFilter`.
# See dx-report.md M1. Restore any order once fixed upstream.
import "../bloom.aql" end
import "boru:test" end


# --- derived params ------------------------------------------------

[
  def bf ({n: 1000, p: 0.01} Bloom.make end)
  Assert.equal 1000 bf.n
  Assert.equal 0.01 bf.p
  Assert.equal 9586 bf.m
  Assert.equal 7 bf.k
] "derived-params" Test.test end


# --- fresh filter contains nothing ---------------------------------

[
  def bf ({n: 1000, p: 0.01} Bloom.make end)
  Assert.equal false (bf Bloom.contains "anything" end)
] "fresh-contains-nothing" Test.test end


# --- add then contains ---------------------------------------------

[
  def bf ({n: 1000, p: 0.01} Bloom.make end)
  def _ (bf Bloom.add "hello" end)
  Assert.equal true (bf Bloom.contains "hello" end)
  Assert.equal false (bf Bloom.contains "not-there" end)
] "add-then-contains" Test.test end


# --- bulk-insert fixtures ------------------------------------------
#
# `_seen` is populated here at top level, then read inside the two
# Test.test bodies below, which share it. History: it was first hoisted
# out of a Test.test block to dodge two defects that are both fixed on
# boru main @ 64c5ab2 — a bytecode `each` body that dropped a block-local
# binding (dx-report.md §3) and a `boru check` unused_def false positive
# for defs read only inside code bodies. `_fill` keeps its leading
# underscore because it is bound only for its side effect (an unused
# def without one is a real `unused_def` warning).

def _seen ({n: 1000, p: 0.01} Bloom.make end)
def _fill (iota 50 each [ var [[i] _seen Bloom.add (convert String i) end 0 ] ])


# --- bulk-insert: every item is found ------------------------------

[
  def hits (iota 50 each [
    var [[i] if (_seen Bloom.contains (convert String i) end) [1] [0] ]
  ])
  Assert.equal 50 (0 hits [add end] fold)
] "bulk-add-all-found" Test.test end


# --- count tracks the insertion count ------------------------------

[
  def cnt (_seen Bloom.count end)
  Assert.equal true (45 lte cnt)
  Assert.equal true (cnt lte 55)
] "count-within-tolerance" Test.test end


# --- params snapshot -----------------------------------------------

[
  def bf ({n: 1000, p: 0.01} Bloom.make end)
  def ps (bf Bloom.params end)
  Assert.equal 1000 (ps "n" get)
  Assert.equal 0.01 (ps "p" get)
  Assert.equal 9586 (ps "m" get)
  Assert.equal 7 (ps "k" get)
] "params-snapshot" Test.test end


# --- merge: union of two filters with matching (m, k) --------------

[
  def a ({n: 1000, p: 0.01} Bloom.make end)
  def b ({n: 1000, p: 0.01} Bloom.make end)
  def _a (a Bloom.add "from-a" end)
  def _b (b Bloom.add "from-b" end)
  def merged (a Bloom.merge b end)
  Assert.equal true (merged Bloom.contains "from-a" end)
  Assert.equal true (merged Bloom.contains "from-b" end)
] "merge-union" Test.test end


# --- merge: mismatched (m, k) is rejected --------------------------

[
  def a ({n: 1000, p: 0.01} Bloom.make end)
  def b ({n:  500, p: 0.01} Bloom.make end)
  [a Bloom.merge b end] Assert.throws end
] "merge-mismatch-throws" Test.test end


# --- merge: the mismatch error carries a dispatchable code ----------

[
  def a ({n: 1000, p: 0.01} Bloom.make end)
  def b ({n:  500, p: 0.01} Bloom.make end)
  def e (do [a Bloom.merge b end])
  Assert.equal incompatible_merge/q (e.code)
] "merge-mismatch-code" Test.test end


# --- make: out-of-range arguments raise bad_input -------------------

[
  def e1 (do [{n: 0, p: 0.01} Bloom.make end])
  Assert.equal bad_input/q (e1.code)
  def e2 (do [{n: 1000, p: 0.7} Bloom.make end])
  Assert.equal bad_input/q (e2.code)
  def e3 (do [{n: 1000} Bloom.make end])
  Assert.equal bad_input/q (e3.code)
] "make-validates-input" Test.test end


# --- decode: rebuilds an encoded filter -----------------------------

[
  def bf ({n: 1000, p: 0.01} Bloom.make end)
  def _h (bf Bloom.add "hello" end)
  def _w (bf Bloom.add "world" end)
  def back ((bf Bloom.encode end) Bloom.decode end)
  Assert.equal true (back Bloom.contains "hello" end)
  Assert.equal true (back Bloom.contains "world" end)
  Assert.equal false (back Bloom.contains "absent" end)
  Assert.equal 2 (back "added" get)
  Assert.equal true ((bf Bloom.params end) deq (back Bloom.params end))
  Assert.equal (bf Bloom.encode end) (back Bloom.encode end)
] "decode-round-trips" Test.test end


# --- decode: malformed payloads raise bad_payload --------------------

[
  def e1 (do ["this is not jsonic {" Bloom.decode end])
  Assert.equal bad_payload/q (e1.code)
  def e2 (do ["{n:100, p:0.05}" Bloom.decode end])
  Assert.equal bad_payload/q (e2.code)
] "decode-rejects-malformed" Test.test end


# --- summary -------------------------------------------------------

# One fully-grouped `print (value)` per statement keeps output in source
# order (a chained `"label" print value print` collects forward and
# reorders). `Assert.equal expected actual` is the forward form, so a
# failure reports "expected 0, got N" the right way round.
print "---"
print (`fail count: ${(Test.fail-count)}`)
Assert.equal 0 (Test.fail-count)
print "all green"
